# 知识库 AI 助手 · 服务端代理（可选）环境变量
# 在 Vercel dashboard 或本地 .env（配合 vercel dev）中配置。
# 绝不加 VITE_ 前缀——带前缀的变量会被打进前端 bundle，Key 会泄露。

# 'openai' | 'anthropic'（openai 兼容所有 OpenAI 风格端点，如 DeepSeek/通义/OpenRouter）
LLM_PROVIDER=openai

# 必填：LLM 服务商的 API Key（只存在于服务端，不下发到浏览器）
LLM_API_KEY=

# 可空：自定义上游地址（默认官方端点）
# OpenAI 兼容示例：https://api.deepseek.com/v1
# LLM_BASE_URL=

# 可空：模型名（默认按 provider 给：gpt-4o-mini / claude-haiku-4-5）
# LLM_MODEL=

# 可空：单次回答 max_tokens 服务端钳制上限（默认 2048）
# CHAT_MAX_TOKENS=2048
